#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
BUNDLE_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
RUNTIME_DIR="$BUNDLE_ROOT/runtime"

[[ -x "$RUNTIME_DIR/nvim/bin/nvim" ]] || {
  echo "Offline runtime is incomplete: missing Neovim binary" >&2
  exit 1
}

if [[ "${NVIM_MAINTENANCE:-0}" == 1 && "${NVIM_OFFLINE:-1}" == 0 ]]; then
  export NVIM_OFFLINE=0
else
  export NVIM_OFFLINE=1
fi
export XDG_CONFIG_HOME="$RUNTIME_DIR/config"
export XDG_DATA_HOME="$RUNTIME_DIR/data"
export XDG_STATE_HOME="$RUNTIME_DIR/state"
export XDG_CACHE_HOME="$RUNTIME_DIR/cache"
export PATH="$RUNTIME_DIR/bin:$XDG_DATA_HOME/nvim/mason/bin:$PATH"
export PYTHONHOME="$RUNTIME_DIR"
export LD_LIBRARY_PATH="$RUNTIME_DIR/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

exec "$RUNTIME_DIR/nvim/bin/nvim" "$@"
